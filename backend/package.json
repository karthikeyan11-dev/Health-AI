{
  "name": "health-ai-backend",
  "version": "1.0.0",
  "description": "Production-grade backend service for Health AI Smart Healthcare Monitoring Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "seed": "tsx src/scripts/seed.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\" \"tests/**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,md}\" \"tests/**/*.{ts,js,json,md}\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "openapi:lint": "redocly lint openapi/openapi.yaml",
    "openapi:bundle": "redocly bundle openapi/openapi.yaml -o openapi/dist/openapi.bundle.yaml && node -e \"const fs = require('fs'); if (fs.existsSync('../frontend')) fs.copyFileSync('openapi/dist/openapi.bundle.yaml', '../frontend/openapi.bundle.yaml');\"",
    "openapi:build": "pnpm openapi:lint && pnpm openapi:bundle",
    "openapi:generate": "openapi-typescript openapi/dist/openapi.bundle.yaml --output src/shared/types/generated/api-types.ts",
    "openapi:watch": "openapi-typescript openapi/openapi.yaml --output src/shared/types/generated/api-types.ts --watch",
    "openapi:validate": "redocly lint openapi/openapi.yaml",
    "openapi:gen": "pnpm openapi:build && pnpm openapi:generate",
    "precommit": "pnpm lint && pnpm format:check && pnpm type-check && pnpm test:coverage && pnpm build",
    "prepare": "cd .. && husky || true"
  },
  "dependencies": {
    "@getbrevo/brevo": "^6.0.2",
    "awilix": "^13.0.5",
    "axios": "^1.8.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "envalid": "^8.2.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.46.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.1",
    "@types/pino-http": "^6.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.7",
    "openapi-typescript": "^7.13.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.5.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.24.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "openapi/**": [
      "redocly lint"
    ]
  }
}
