{
  "name": "health-ai-backend",
  "version": "1.0.0",
  "description": "Production-grade backend service for Health AI Smart Healthcare Monitoring Platform",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/app.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,md}\"",
    "openapi:lint": "redocly lint openapi/openapi.yaml",
    "openapi:bundle": "redocly bundle openapi/openapi.yaml -o openapi/dist/openapi.bundle.json",
    "openapi:types": "openapi-typescript openapi/openapi.yaml -o src/types/generated/api-types.ts",
    "openapi:gen": "pnpm openapi:lint && pnpm openapi:bundle && pnpm openapi:types",
    "prepare": "cd .. && husky || true"
  },
  "dependencies": {
    "axios": "^1.8.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.46.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/pino-http": "^5.8.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "openapi-typescript": "^7.13.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.11",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.66.0"
  },
  "keywords": [
    "health-ai",
    "iot",
    "esp32",
    "telemetry",
    "digital-twin",
    "clean-architecture",
    "openapi"
  ],
  "author": "Health AI Engineering Team",
  "license": "MIT",
  "packageManager": "pnpm@10.34.4"
}
