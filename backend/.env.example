# ==============================================================================
# Health AI Backend Environment Variables Template (.env.example)
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb://admin:healthai_secret_pass@localhost:27017/health_ai_db?authSource=admin

# Super Admin Initial Credentials
SUPER_ADMIN_EMAIL=admin@healthai.org
SUPER_ADMIN_PASSWORD=change_me_strong_password

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Python AI Microservice (emotion_detection)
AI_SERVICE_URL=http://localhost:5001

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email Provider Configuration (Brevo / Mock)
EMAIL_PROVIDER=brevo
EMAIL_SENDER_EMAIL=noreply@healthai.org
EMAIL_SENDER_NAME=Health AI Platform
BREVO_API_KEY=

# OTP & Registration Configuration
REGISTRATION_OTP_EXPIRY_SECONDS=300

# Logging
LOG_LEVEL=debug
